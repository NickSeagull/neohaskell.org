---
import HomepageVisual from '../components/HomepageVisual.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import Arrow from '../components/Arrow.astro';
import VisitorContext from '../components/VisitorContext.astro';
import '../styles/home.css';

const capabilities = [
  { icon: 'layers', title: 'Convention over configuration', text: 'A shared project structure and sensible defaults. Spend your time on what makes your application different, not on wiring it together.' },
  { icon: 'document', title: 'OpenAPI, automatically', text: 'API documentation comes from your command and query types. As your application changes, its contract changes with it.' },
  { icon: 'key', title: 'OAuth connections', text: 'Let users connect their accounts from other services. The framework handles authorization flows, token storage and refresh.' },
  { icon: 'database', title: 'PostgreSQL built in', text: 'Give your events and query data a durable home. Use PostgreSQL through the same storage interfaces your application already knows.' },
  { icon: 'upload', title: 'Files, handled', text: 'Accept uploads and store generated documents, with ownership, validation and access control as part of the framework.' },
  { icon: 'shield', title: 'Identity and access', text: 'Connect an identity provider and define who can do what. Authentication and access policies work together across your application.' },
] as const;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="NeoHaskell is an AI-first language and framework. Build with your agent, keep a history of every change, and get APIs, authentication, PostgreSQL and file storage built in." />
    <meta name="theme-color" content="#1c062d" />
    <link rel="canonical" href="https://neohaskell.org/" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preload" href="/fonts/sansation.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content="NeoHaskell: Build with AI. Keep control." />
    <meta property="og:description" content="An AI-first language and framework with pure business logic, recorded history and the essentials built in. Build your next application with your AI agent." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://neohaskell.org/" />
    <title>NeoHaskell: Build with AI. Keep control.</title>
    <script is:inline>
      (() => {
        let preference;
        try { preference = localStorage.getItem('starlight-theme'); } catch {}
        const theme = preference === 'light' || preference === 'dark' ? preference : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'light' ? '#fafafc' : '#1c062d';
      })();
    </script>
    <VisitorContext />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="brand" aria-label="NeoHaskell home"><img src="/logo.svg" width="43" height="43" alt="" /><span>NeoHaskell</span></a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="/learn/" class="nav-guide"><span class="nav-label-full">Documentation</span><span class="nav-label-short">Docs</span></a>
          <a href="/resources/" class="nav-resources">Resources</a>
          <a href="https://github.com/neohaskell/NeoHaskell" class="github-link">GitHub<svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
        </button>
      </header>
      <main id="main">
        <section class="opening" aria-labelledby="headline">
          <div class="hero-copy">
            <h1 id="headline">Build with AI.<br />Keep <span class="pixel-word">control.</span></h1>
            <p class="hero-description">An AI-first language and framework for turning your ideas into applications. Pure business logic, a history of every change, and the essentials already built in.</p>
            <div class="hero-actions"><a href="/learn/" class="primary-link">Explore the docs<Arrow /></a><a href="#framework" class="secondary-link">See what's included</a></div>
          </div>
          <HomepageVisual kind="application" />
        </section>

        <section class="history-section" aria-labelledby="history-title">
          <div class="history-copy">
            <h2 id="history-title">Your data<br />has a memory</h2>
            <p>Most applications only remember where things ended up. NeoHaskell remembers how they got there. Every change is recorded as an event, giving you a history you can follow, replay and build on.</p>
            <p>Trace an unexpected result. Correct a mistake without erasing the past. Rebuild your queries from the same history when your application evolves.</p>
            <a href="/learn/#events" class="text-link">Discover event sourcing<Arrow /></a>
          </div>
          <HomepageVisual kind="history" />
        </section>

        <section class="benefit-pair" aria-label="A safer foundation, with room to grow">
          <article class="purity-benefit">
            <div class="benefit-copy"><h2>More freedom to build.<br />Fewer ways to break things.</h2>
              <p>Your business logic stays pure. It cannot quietly write to a database, call a service or change a file. The language checks that boundary, so you and your agent can change one decision without hidden side effects.</p>
            </div>
            <HomepageVisual kind="pure" />
          </article>
          <article class="transport-benefit">
            <div class="benefit-copy"><h2>New transport.<br />Same application.</h2>
              <p>An HTTP server for your app. An MCP server for AI tools. Switch the transport with one line of configuration and keep the business logic you've already built.</p>
            </div>
            <HomepageVisual kind="transport" />
          </article>
        </section>

        <section class="framework-section" id="framework" aria-labelledby="framework-title">
          <div class="section-heading"><h2 id="framework-title">The framework<br />comes with the language</h2><p>Less assembly. More application. The pieces you would usually choose, connect and maintain are designed to work together from the start.</p></div>
          <div class="capability-grid">
            {capabilities.map(({ icon, title, text }) => <article><FeatureIcon name={icon} /><h3>{title}</h3><p>{text}</p></article>)}
          </div>
          <a href="/resources/#language-and-framework" class="text-link">Explore the framework<Arrow /></a>
        </section>

        <section class="agent-section" aria-labelledby="agent-title">
          <div class="agent-intro"><h2 id="agent-title">Your ideas.<br />Your agent.<br /> A shared way to build.</h2><p>Give your agent a framework it can follow. NeoHaskell's <a href="https://github.com/neohaskell/skills">skills for Claude Code and Codex</a> guide the work from the behavior you want to the checks that verify it.</p><a href="/getting-started/" class="text-link">Build with your agent<Arrow /></a></div>
          <div class="agent-workflow">
            <div class="workflow-intent"><span class="workflow-mark" aria-hidden="true"></span><h3>Start with what should happen</h3><p>Describe your feature and the rules it needs to follow.</p><blockquote>"Customers can cancel an order before it ships."</blockquote></div>
            <div class="workflow-build"><span class="workflow-mark" aria-hidden="true"></span><h3>Let your agent connect the pieces</h3><p>Business logic, API, frontend and tests, built around the same model.</p></div>
            <div class="workflow-check"><span class="workflow-mark" aria-hidden="true"><FeatureIcon name="check" /></span><h3>Check it against your intent</h3><p>Review the behavior, run the checks and make the next change with context.</p></div>
          </div>
        </section>

        <section class="closing-section" aria-labelledby="closing-title">
          <div><h2 id="closing-title">Build the idea<br />you keep thinking about.</h2><a href="/learn/" class="primary-link">Explore the docs<Arrow /></a></div>
          <img class="closing-logo" src="/logo.svg" width="240" height="240" alt="" loading="lazy" />
        </section>
      </main>
      <footer class="site-footer"><a href="/" class="footer-brand">NeoHaskell</a><nav aria-label="Footer navigation"><a href="/learn/">Documentation</a><a href="/resources/">Resources</a><a href="https://github.com/neohaskell/NeoHaskell">GitHub</a><a href="https://discord.com/invite/wDj3UYzec8">Discord</a></nav></footer>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const root = document.documentElement;
      const updateLabel = () => {
        const target = root.dataset.theme === 'dark' ? 'light' : 'dark';
        button?.setAttribute('aria-label', `Switch to ${target} theme`);
        button?.setAttribute('title', `Switch to ${target} theme`);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', target === 'light' ? '#1c062d' : '#fafafc');
      };
      button?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        try { localStorage.setItem('starlight-theme', theme); } catch {}
        updateLabel();
      });
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
        let preference;
        try { preference = localStorage.getItem('starlight-theme'); } catch {}
        if (preference !== 'light' && preference !== 'dark') { root.dataset.theme = event.matches ? 'light' : 'dark'; updateLabel(); }
      });
      updateLabel();
    </script>
  </body>
</html>
