---
import Arrow from './Arrow.astro';
import { messages, sitePath } from '../i18n/runtime';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = messages(locale);
const modelPage = sitePath(locale, '/introduction/event-modeling/');
---

<section class="spec-highlight" id="specification" aria-labelledby="spec-title">
  <div class="highlight-copy">
    <h2 id="spec-title">{t('home.app-spec-title')}</h2>
    <p>{t('home.app-spec-description')}</p>
  </div>
  <div class="spec-document" lang="en">
    <div class="spec-requirement">
      <h3>{t('home.app-spec-example-title')}</h3>
      <p>{t('home.app-spec-example-requirement')}</p>
    </div>
    <pre class="homepage-spec" tabindex="0" aria-label={t('home.app-spec-code-label')}><code><span class="spec-keyword">feature</span> <span class="spec-string">"Orders"</span> <span class="spec-keyword">do</span>{'\n'}  <span class="spec-keyword">chapter</span> <span class="spec-string">"Place order"</span> <span class="spec-keyword">do</span>{'\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Accept order"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">entity</span> @Order <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">command</span> @PlaceOrder <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">produces</span> @OrderPlaced{'\n\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Show stock"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">query</span> @AvailableMugs <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">readsFrom</span> @Order <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">onEvent</span> @OrderPlaced</code></pre>
  </div>
  <a class="text-link" href={modelPage}>{t('home.app-spec-action')}<Arrow /></a>
</section>

<style>
  .spec-highlight { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 80px; align-items: center; padding: 80px 0; border-top: 1px solid var(--rule); }
  .highlight-copy { grid-column: 2; align-self: end; }
  .highlight-copy p { margin-top: 24px; max-width: 48ch; }
  .spec-highlight > .text-link { grid-column: 2; align-self: start; }
  .spec-document { position: relative; grid-column: 1; grid-row: 1 / 3; min-width: 0; padding: 32px; border: 1px solid var(--line); border-radius: 2px; background: var(--scene); }
  .spec-document::before { content: ''; position: absolute; top: -1px; right: -1px; width: 32px; height: 32px; background: var(--ground); clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .spec-document::after { content: ''; position: absolute; top: -1px; right: -1px; width: 32px; height: 32px; background: var(--line); clip-path: polygon(0 0, 100% 100%, 0 100%); }
  .spec-requirement { padding-bottom: 24px; border-bottom: 1px solid var(--rule); }
  .spec-requirement h3 { font-size: 24px; font-weight: 500; line-height: 1.3; }
  .spec-requirement p { margin-top: 12px; font-size: 18px; max-width: 36ch; }
  .homepage-spec { margin: 24px 0 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) var(--scene); color: var(--ink); font-size: 16px; line-height: 1.8; tab-size: 2; }
  .homepage-spec code { font-family: ui-monospace, monospace; }
  .spec-keyword { color: var(--violet); }
  .spec-string { color: var(--accent); }
  @media (max-width: 1100px) {
    .spec-highlight { gap: 24px 32px; }
    .spec-document { padding: 24px; }
  }
  @media (max-width: 760px) {
    .spec-highlight { grid-template-columns: 1fr; gap: 32px; padding: 48px 0; }
    .highlight-copy, .spec-highlight > .text-link { grid-column: auto; }
    .highlight-copy p { margin-top: 20px; }
    .spec-document { grid-column: auto; grid-row: auto; }
    .spec-highlight > .text-link { grid-row: 3; }
  }
  @media (max-width: 480px) {
    .spec-document { padding: 24px 20px; }
  }
</style>
