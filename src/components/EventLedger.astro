---
const { compact = false } = Astro.props;
---
<figure class:list={['event-model', { compact }]} aria-label="Example order model">
  <div class="model-drawing" data-ledger data-stage="4">
    <svg class="ledger-desktop" viewBox="0 0 1320 218" role="img" aria-labelledby="ledger-title ledger-desc">
      <title id="ledger-title">One order. A lasting record.</title>
      <desc id="ledger-desc">In this example, a command places an order for one mug. A decision accepts it when stock is available. OrderPlaced is recorded in the event ledger. The stock query returns two mugs remaining, down from three.</desc>
      <defs><marker id="model-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="m1 1 5 2.5-5 2.5" class="arrow-head"/></marker></defs>
      <g class="model-connections"><path d="M270 122H340" marker-end="url(#model-arrow)"/><path d="M536 122H610" marker-end="url(#model-arrow)"/><path d="M946 122H1034" marker-end="url(#model-arrow)"/></g>
      <g class="model-command"><text class="node-label" x="151" y="36" text-anchor="middle">Command</text><path class="command-shape node-shape" d="M54 76H290L250 168H14Z"/><text class="node-name" x="151" y="118" text-anchor="middle">Place order</text><text class="node-detail" x="151" y="145" text-anchor="middle">1 mug</text></g>
      <g class="model-decision"><text class="node-label" x="438" y="36" text-anchor="middle">Decision</text><path class="decision-shape node-shape" d="m438 61 98 61-98 61-98-61Z"/><text class="node-name" x="438" y="116" text-anchor="middle">In stock?</text><text class="decision-verdict node-detail" x="438" y="144" text-anchor="middle">Yes</text></g>
      <g class="model-events"><text class="node-label" x="778" y="36" text-anchor="middle">Event ledger</text><rect class="ledger-frame node-shape" x="610" y="60" width="336" height="128" rx="4"/><g class="ledger-entry"><rect class="entry-fill" x="624" y="83" width="308" height="82" rx="2"/><text class="event-index" x="640" y="133">01</text><text class="event-name" x="678" y="134">OrderPlaced</text><path class="event-check" d="m896 124 7 7 13-15"/></g></g>
      <g class="model-query"><text class="node-label" x="1172" y="36" text-anchor="middle">Query</text><rect class="query-shape node-shape" x="1036" y="69" width="272" height="111" rx="14"/><text class="stock-value" x="1082" y="143" text-anchor="middle" data-stock>2</text><text class="node-name query-name" x="1120" y="132">mugs in stock</text></g>
      <circle class="flow-dot" r="5" cx="0" cy="0"/>
    </svg>
    <svg class="ledger-mobile" viewBox="0 0 340 427" role="img" aria-labelledby="mobile-ledger-title mobile-ledger-desc">
      <title id="mobile-ledger-title">A mug order through the event model</title>
      <desc id="mobile-ledger-desc">In this example, a command orders one mug. The decision accepts it when stock is available, recording OrderPlaced. The stock query changes from three mugs to two.</desc>
      <defs><marker id="mobile-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="m1 1 5 2.5-5 2.5" class="arrow-head"/></marker></defs>
      <g class="model-connections"><path d="M156 90H182" marker-end="url(#mobile-arrow)"/><path d="M258 145V154Q258 166 246 166H196V201" marker-end="url(#mobile-arrow)"/><path d="M170 301V338" marker-end="url(#mobile-arrow)"/></g>
      <g class="model-command"><text class="node-label" x="83" y="17" text-anchor="middle">Command</text><path class="command-shape node-shape" d="M12 52H162L150 132H0Z"/><text class="node-name" x="83" y="88" text-anchor="middle">Place order</text><text class="node-detail" x="83" y="115" text-anchor="middle">1 mug</text></g>
      <g class="model-decision"><text class="node-label" x="258" y="17" text-anchor="middle">Decision</text><path class="decision-shape node-shape" d="m258 35 76 55-76 55-76-55Z"/><text class="node-name" x="258" y="98" text-anchor="middle">In stock?</text><text class="decision-verdict node-detail" x="258" y="123" text-anchor="middle">Yes</text></g>
      <g class="model-events"><text class="node-label" x="13" y="191">Event ledger</text><rect class="ledger-frame node-shape" x="12" y="204" width="316" height="97" rx="4"/><g class="ledger-entry"><rect class="entry-fill" x="25" y="218" width="290" height="69" rx="2"/><text class="event-index" x="35" y="263">01</text><text class="event-name" x="72" y="263">OrderPlaced</text><path class="event-check" d="m282 254 6 6 12-13"/></g></g>
      <g class="model-query"><text class="node-label" x="15" y="330">Query</text><rect class="query-shape node-shape" x="12" y="342" width="316" height="76" rx="12"/><text class="stock-value" x="58" y="398" text-anchor="middle" data-stock>2</text><text class="node-name" x="98" y="386">mugs in stock</text></g>
    </svg>
  </div>
</figure>
<script>
  const ledger = document.querySelector<HTMLElement>('[data-ledger]');
  if (ledger) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const stock = ledger.querySelectorAll('[data-stock]');
    const dot = ledger.querySelector<SVGCircleElement>('.flow-dot');
    let frame = 0;
    let started = 0;
    let finished = false;
    const duration = 3800;
    const settle = () => {
      finished = true;
      cancelAnimationFrame(frame);
      ledger.dataset.stage = '4';
      stock.forEach((node) => { node.textContent = '2'; });
      if (dot) dot.style.opacity = '0';
    };
    const tick = (now: number) => {
      if (finished) return;
      if (!started) started = now;
      const time = now - started;
      const stage = time < 500 ? 0 : time < 1450 ? 1 : time < 2350 ? 2 : time < 3200 ? 3 : 4;
      ledger.dataset.stage = String(stage);
      stock.forEach((node) => { node.textContent = stage < 4 ? '3' : '2'; });
      if (dot) {
        let x = 0;
        if (time >= 700 && time < 1400) x = 270 + 70 * (time - 700) / 700;
        if (time >= 1650 && time < 2300) x = 536 + 74 * (time - 1650) / 650;
        if (time >= 2500 && time < 3150) x = 946 + 88 * (time - 2500) / 650;
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', '122');
        dot.style.opacity = x ? '1' : '0';
      }
      if (time >= duration) settle();
      else frame = requestAnimationFrame(tick);
    };
    if (!reduced.matches && !document.hidden) {
      ledger.dataset.stage = '0';
      stock.forEach((node) => { node.textContent = '3'; });
      frame = requestAnimationFrame(tick);
    }
    reduced.addEventListener('change', (event) => { if (event.matches) settle(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) settle(); });
  }
</script>
