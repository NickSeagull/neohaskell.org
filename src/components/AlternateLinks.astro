---
import { locales } from '../i18n/locales.mjs';
import { sitePath } from '../i18n/runtime';
interface Props { locale?: string; path?: string; }
const { path = Astro.url.pathname } = Astro.props;
---
{locales.map(({ code, lang }) => <link rel="alternate" hreflang={lang} href={new URL(sitePath(code, path), Astro.site)} />)}
<link rel="alternate" hreflang="x-default" href={new URL(sitePath('en', path), Astro.site)} />
