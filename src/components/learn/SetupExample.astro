---
interface Props { kind: string; id: string; }
const { kind, id } = Astro.props;
const prompt = 'Let a customer order one ceramic mug. Accept the order only when the quantity is positive and stock is available. Record an accepted order as OrderPlaced, and provide a query for remaining stock. If there is not enough stock, reject the command without recording an accepted order. Check both outcomes.';
---
<div class="setup-example" data-setup-example={kind}>
  {kind === 'environment' && <><h3 class="sr-only">Environment checklist</h3><div class="setup-checklist" data-setup-checklist data-setup-artifact>{['NeoHaskell environment ready','Node.js 22.20 or newer','Terminal at the project’s Git root'].map((label,index) => <label><input type="checkbox" id={`${id}-check-${index}`} /><span>{label}</span></label>)}</div><p class="setup-feedback" data-checklist-status role="status">0 of 3 checked by you</p><a class="source-link" href="https://github.com/neohaskell/NeoHaskell#readme">Environment guide</a></>}
  {kind === 'skills' && <><h3 class="sr-only">Install agent skills</h3><div class="shell-example" data-setup-artifact><pre><code><button type="button" data-shell-part="runner">npx</button> <button type="button" data-shell-part="installer">skills add</button> \
  <button type="button" data-shell-part="repository">neohaskell/skills</button> \
  <button type="button" data-shell-part="collection">--skill '*'</button></code></pre></div><p class="shell-explanation" data-shell-explanation role="status" hidden></p><button type="button" class="run-order" data-copy-install>Copy install command</button><a class="source-link" href="https://github.com/neohaskell/skills#install">Installation instructions</a></>}
  {kind === 'first-task' && <><h3 class="sr-only">Describe your first task</h3><label class="prompt-label" for={`${id}-prompt`}>First task for your agent</label><textarea id={`${id}-prompt`} data-agent-prompt data-setup-artifact rows="5" spellcheck="false">{prompt}</textarea><div class="prompt-actions"><button type="button" class="run-order" data-copy-prompt>Copy task</button><button type="button" class="quiet-button" data-reset-prompt>Restore</button></div><p class="sr-only" data-prompt-status role="status"></p></>}
  {kind === 'review' && <><h3 class="sr-only">Expected order outcomes</h3><div class="outcome-switch" role="group" aria-label="Expected outcome"><button type="button" data-outcome-choice="accepted" aria-pressed="true">Stock available</button><button type="button" data-outcome-choice="rejected" aria-pressed="false">Sold out</button></div><dl class="expected-results" data-setup-artifact><div><dt>Starting stock</dt><dd data-expected-stock>3 mugs</dd></div><div><dt>Command</dt><dd>Place order · 1 mug</dd></div><div><dt>Decision</dt><dd data-expected-decision>Accept</dd></div><div><dt>Recorded event</dt><dd data-expected-event>OrderPlaced</dd></div><div><dt>Stock query</dt><dd data-expected-query>2 mugs</dd></div></dl></>}
</div>
