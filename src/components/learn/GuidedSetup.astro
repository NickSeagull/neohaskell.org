---
import SetupExample from './SetupExample.astro';
const steps = [
 {id:'environment',title:'Prepare your environment.',lead:'Start from a model you can explain.',body:'Follow the current NeoHaskell project instructions for the framework and development environment. Use the requirements for the version you intend to work with. The agent-skills installer also requires Node.js 22.20 or newer.',note:'The checklist is yours to mark. This page does not inspect your computer.'},
 {id:'skills',title:'Equip your agent.',lead:'The NeoHaskell skills give your coding agent project-specific guidance.',body:'From your application’s Git root, install the skills collection. The installer asks which agent and installation scope to use. Select the complete collection so related skills and resources are available together.',note:'The current collection supports Claude Code and Codex. Keep the installed files and lockfile with your project.'},
 {id:'first-task',title:'Ask for one useful behavior.',lead:'Give the agent an intention, the decision that allows it, and the result you expect.',body:'Use the small shop as your starting point. Explain both what should happen when stock is available and what should happen when it is not. Edit the task beside this paragraph, then copy it into your agent.',note:'Start with a behavior you can check. You can add payments, shipping, and other conditions as separate changes.'},
 {id:'review',title:'Check what the application does.',lead:'Compare the implementation with the model you understand.',body:'Check an accepted order and a rejected one. In the example, an accepted order records OrderPlaced and reduces stock; a sold-out shop records no accepted-order event and stays at zero.',note:'Technical checks matter. You still decide whether the behavior matches the application you intended.'}
];
---
<div class="guided-doc setup-doc scene-doc" data-guided-setup>
  <div class="lesson-heading"><h1 id="_top">An understood model.<br /><span>A useful first task.</span></h1><p>Bring what you’ve learned to your AI agent.<br class="desktop-break" /> Set up, describe one behavior, and check the result.</p><div class="lesson-meta"><a href="/learn/">Revisit the concepts</a></div></div>
  <div class="lesson-layout">
    <div class="lesson-scenes">{steps.map(step => <section class="lesson-step" id={step.id} data-setup-step={step.id} data-scroll-scene><div class="scene-copy"><h2><a href={`#${step.id}`}>{step.title}</a></h2><p class="step-lead">{step.lead}</p><p>{step.body}</p><p>{step.note}</p></div></section>)}</div>
    <aside class="lesson-companion" aria-label="Current setup example" data-lesson-companion>
      <div class="order-example">{steps.map(step => <SetupExample kind={step.id} id={`setup-${step.id}`} />)}</div>
    </aside>
  </div>
  <div class="setup-source-note"><p>Installation command checked against the <a href="https://github.com/neohaskell/skills/blob/0ff0872d554e79d955f4c92f9b905056b908e9ae/README.md">NeoHaskell skills README</a>, 9 November 2026. Check the current source for updates.</p><a href="/learn/">Back to the model</a></div>
</div>
<script>
  import { beforeExampleResize, scrollSections } from '../../scripts/scroll-sections';
  const root = document.querySelector<HTMLElement>('[data-guided-setup]');
  if (root) {
    let attention: Animation | undefined;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    scrollSections(root, (scene, changed) => {
      const example = root.querySelector<HTMLElement>(`[data-setup-example="${scene.dataset.setupStep}"]`)!;
      root.querySelectorAll<HTMLElement>('[data-setup-example]').forEach(el => { el.dataset.current = String(el === example); el.hidden = el !== example; });
      root.querySelector('[data-lesson-companion]')!.scrollTop = 0;
      attention?.cancel();
      if (changed && !motion.matches && !document.hidden) attention = example.querySelector('[data-setup-artifact]')!.animate([{transform:'translateY(-4px)',filter:'brightness(1.25)'},{transform:'translateY(0)',filter:'brightness(1)'}],{duration:550,easing:'cubic-bezier(.16,1,.3,1)'});
    });
    motion.addEventListener('change',()=>{if(motion.matches)attention?.cancel()});
    document.addEventListener('visibilitychange',()=>{if(document.hidden)attention?.cancel()});
    const explanations:Record<string,string>={runner:'npx runs the installer using your Node.js environment.',installer:'skills add installs agent skills into the location you choose.',repository:'neohaskell/skills is the source collection maintained by the NeoHaskell project.',collection:"--skill '*' selects the full collection. Quotes keep your shell from expanding the asterisk."};
    root.querySelectorAll<HTMLElement>('[data-setup-example]').forEach(example=>{
      const checks=[...example.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
      checks.forEach(check=>check.addEventListener('change',()=>{example.querySelector('[data-checklist-status]')!.textContent=`${checks.filter(c=>c.checked).length} of 3 checked by you`;}));
      let pinned='';
      const explain=(key:string)=>{beforeExampleResize(example);const output=example.querySelector<HTMLElement>('[data-shell-explanation]');if(output){output.textContent=explanations[key]||'';output.hidden=!key;}example.querySelectorAll<HTMLElement>('[data-shell-part]').forEach(b=>b.setAttribute('aria-pressed',String(!!pinned&&b.dataset.shellPart===pinned)));};
      example.querySelectorAll<HTMLButtonElement>('[data-shell-part]').forEach(button=>{const key=button.dataset.shellPart!;button.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')explain(key)});button.addEventListener('pointerleave',()=>explain(pinned));button.addEventListener('focus',()=>explain(key));button.addEventListener('blur',()=>explain(pinned));button.addEventListener('click',()=>{pinned=pinned===key?'':key;explain(pinned)});});
      example.addEventListener('keydown',event=>{if(event.key==='Escape'){pinned='';explain('')}});
      const copy = async(button:HTMLButtonElement,text:string)=>{try{await navigator.clipboard.writeText(text);button.textContent='Copied';}catch{button.textContent='Select the text to copy';}};
      example.querySelector<HTMLButtonElement>('[data-copy-install]')?.addEventListener('click',event=>copy(event.currentTarget as HTMLButtonElement,"npx skills add neohaskell/skills --skill '*'"));
      const area=example.querySelector<HTMLTextAreaElement>('[data-agent-prompt]');const original=area?.value;
      example.querySelector<HTMLButtonElement>('[data-copy-prompt]')?.addEventListener('click',event=>copy(event.currentTarget as HTMLButtonElement,area!.value));
      example.querySelector('[data-reset-prompt]')?.addEventListener('click',()=>{area!.value=original!;example.querySelector('[data-prompt-status]')!.textContent='Example restored. Edit it to describe your application.';area!.focus();});
      example.querySelectorAll<HTMLButtonElement>('[data-outcome-choice]').forEach(button=>button.addEventListener('click',()=>{const accepted=button.dataset.outcomeChoice==='accepted';for(const[key,value]of Object.entries({stock:accepted?'3 mugs':'0 mugs',decision:accepted?'Accept':'Reject',event:accepted?'OrderPlaced':'No accepted-order event',query:accepted?'2 mugs':'0 mugs'})){example.querySelector(`[data-expected-${key}]`)!.textContent=value;}example.querySelectorAll('[data-outcome-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
    });
    document.documentElement.dataset.learningReady='true';
  }
</script>
