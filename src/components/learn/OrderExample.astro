---
interface Props { id: string; stage?: number; inline?: boolean; }
const { id, stage = 1, inline = false } = Astro.props;
const soldOut = stage === 5;
const recorded = stage >= 3 && !soldOut;
const remaining = soldOut ? 0 : stage >= 4 ? 2 : 3;
const source = 'https://github.com/neohaskell/skills/blob/0ff0872d554e79d955f4c92f9b905056b908e9ae/skills/implement-command/references/update.md';
---
<div class:list={['order-example', { 'inline-example': inline }]} data-order-example data-default-stage={stage} data-stage={stage} data-exploring="false" data-recorded={String(recorded)} data-focus={['command','decision','event','query','decision'][stage-1]} id={id} aria-label="Illustrative order example">

  <div class="model-view" data-model-view>
    <div class="order-drawing">
      <svg class="stage-wires" viewBox="0 0 480 320" preserveAspectRatio="none" aria-hidden="true"><path class="wire wire-command" d="M208 60H276"/><path class="wire wire-event" d="M368 106V127Q368 140 354 140H240V168"/><path class="wire wire-query" d="M240 232V266"/></svg>
      <button class="diagram-node command-node" type="button" data-inspect="command" aria-label="Command: order one mug" aria-describedby={`${id}-explanation`}><strong>Order <span data-quantity>1</span> mug<span data-plural></span></strong></button>
      <button class="diagram-node decision-node" type="button" data-inspect="decision" aria-label={`Decision: ${stage < 2 ? 'pending' : soldOut ? 'reject' : 'accept'}`} aria-describedby={`${id}-explanation`}><svg viewBox="0 0 200 110" preserveAspectRatio="none" aria-hidden="true"><path d="M100 2 198 55 100 108 2 55Z"/></svg><strong data-decision>{stage < 2 ? 'In stock?' : soldOut ? 'Reject' : 'Accept'}</strong></button>
      <button class="diagram-node event-node" type="button" data-inspect="event" aria-label={`Event ledger: ${recorded ? 'OrderPlaced, one mug' : 'no event'}`} aria-describedby={`${id}-explanation`}><span class="event-record" data-event-row hidden={!recorded}><code>OrderPlaced</code></span><span class="empty-ledger" data-empty-row hidden={recorded}>No event</span></button>
      <button class="diagram-node query-node" type="button" data-inspect="query" aria-label={`Query: ${remaining} mugs left${stage === 3 ? ', before the update' : ''}`} aria-describedby={`${id}-explanation`}><span class="query-answer"><span data-stock>{remaining}</span> left<span data-query-before hidden={stage !== 3}>, before</span></span></button>
    </div>
  </div>
  <div class="code-view" id={`${id}-code`} data-code-view hidden>
    <pre aria-label="Illustrative command declaration"><code><span class="syntax-keyword">data</span> <button type="button" class="code-token" aria-describedby={`${id}-explanation`} data-inspect="command">PlaceOrder</button> = PlaceOrder
  {'{'} <button type="button" class="code-token" aria-describedby={`${id}-explanation`} data-inspect="identity">entityId</button> :: <span class="syntax-type">Uuid</span>
  , <button type="button" class="code-token" aria-describedby={`${id}-explanation`} data-inspect="quantity">quantity</button> :: <button type="button" class="code-token syntax-type" aria-describedby={`${id}-explanation`} data-inspect="integer">Int</button>
  {'}'}
  <span class="syntax-keyword">deriving</span>
    (Generic, Typeable, Show)</code></pre>
    <div class="code-actions"><a class="source-link" href={source}>Source template</a><button type="button" class="quiet-button" data-copy-code>Copy code</button></div>
  </div>
  <div class="example-caption" id={`${id}-explanation`} hidden><p data-explanation role="status"></p><button class="quiet-button" type="button" aria-label="Unpin explanation" data-unpin hidden>Unpin</button></div>
  <p class="sr-only" data-order-status role="status" aria-live="polite"></p>
  <div class="example-actions"><button class="scenario-action" type="button" data-scenario-action data-interactive>{stage < 2 ? 'Place order' : soldOut ? 'Restock & try' : 'Try 4 mugs'}<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></button>
  <button type="button" class="quiet-button" data-code-toggle aria-expanded="false" aria-controls={`${id}-code`} data-interactive>Code</button></div>
</div>
