---
import { messages } from '../../i18n/runtime';
const t = messages(Astro.locals.starlightRoute.locale ?? 'en');
interface Props { kind: 'story' | 'decision' | 'queries'; }
const { kind } = Astro.props;
---

{kind === 'story' && (
  <figure class="model-tour not-content customer-story" aria-label={t("lesson.a-customer-orders-one-of-three-available-mugs-the-order-is-confirmed-and-two-mugs-remain")}>
    <div class="shop-screen" data-diagram-role="query"><span>{t("lesson.ceramic-mugs")}</span><strong class="stock-number">3</strong><span>{t("lesson.available-to-order")}</span></div>
    <div class="story-action" data-diagram-role="command"><strong>{t("lesson.order-one-mug")}</strong><svg class="flow-arrow" viewBox="0 0 48 24" width="48" height="24" fill="none" aria-hidden="true"><path d="M2 12h42m-8-8 8 8-8 8" /></svg></div>
    <div class="shop-screen confirmed-screen" data-diagram-role="query"><strong>{t("lesson.order-confirmed")}</strong><strong class="stock-number">2</strong><span>{t("lesson.mugs-still-available")}</span></div>
  </figure>
)}

{kind === 'decision' && (
  <figure class="model-tour not-content decision-flow" aria-label={t("lesson.command-order-one-mug-decision-three-are-available-so-accept-event-an-order-for-one-mug-wa")}>
    <div class="model-node command-node" data-diagram-role="command"><span class="model-role">{t("lesson.command")}</span><strong>{t("lesson.order-one-mug")}</strong></div>
    <svg class="flow-arrow" viewBox="0 0 48 24" width="32" height="24" fill="none" aria-hidden="true"><path d="M2 12h42m-8-8 8 8-8 8" /></svg>
    <div class="model-node decision-node"><span class="model-role">{t("lesson.decision")}</span><strong>{t("lesson.enough-stock")}</strong><span>{t("lesson.3-available-1-needed")}</span></div>
    <svg class="flow-arrow" viewBox="0 0 48 24" width="32" height="24" fill="none" aria-hidden="true"><path d="M2 12h42m-8-8 8 8-8 8" /></svg>
    <div class="model-node event-node" data-diagram-role="event"><span class="model-role">{t("lesson.event")}</span><strong>{t("lesson.order-placed")}</strong><span>{t("lesson.1-ceramic-mug")}</span></div>
  </figure>
)}

{kind === 'queries' && (
  <figure class="model-tour not-content query-flow" aria-label={t("lesson.starting-with-three-mugs-one-recorded-order-for-one-mug-gives-two-query-answers-two-mugs-a")}>
    <div class="model-history"><p class="opening-stock">{t("lesson.opening-stock-3-mugs")}</p><div class="model-node event-node" data-diagram-role="event"><span class="model-role">{t("lesson.recorded-event")}</span><strong>{t("lesson.order-placed")}</strong><span>{t("lesson.1-ceramic-mug")}</span></div></div>
    <svg class="flow-arrow" viewBox="0 0 48 24" width="32" height="24" fill="none" aria-hidden="true"><path d="M2 12h42m-8-8 8 8-8 8" /></svg>
    <div class="query-answers">
      <div class="query-answer" data-diagram-role="query"><span class="model-role">{t("lesson.query")}</span><strong>{t("lesson.available-mugs")}</strong><span class="query-value">2</span></div>
      <div class="query-answer" data-diagram-role="query"><span class="model-role">{t("lesson.query")}</span><strong>{t("lesson.confirmed-orders")}</strong><span class="query-value">1</span></div>
    </div>
  </figure>
)}

<style>
  .model-tour { margin: 2rem 0; color: var(--sl-color-white); font-size: 1rem; line-height: 1.5; }
  .model-tour :is(div, p, strong, span, ol, li, svg) { margin: 0; line-height: 1.5; }
  .model-tour strong { font-weight: 650; }
  .model-tour .flow-arrow { color: var(--sl-color-gray-3); flex-shrink: 0; }
  .flow-arrow path { stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .customer-story { display: grid; grid-template-columns: 1fr 8rem 1fr; gap: 1rem; align-items: center; }
  .shop-screen { display: grid; padding: 1.5rem; border: 1px solid var(--diagram-line); border-radius: .75rem; background: var(--diagram-surface); }
  .shop-screen .stock-number { margin-block: .5rem; font-size: 2.5rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .shop-screen .stock-number, .confirmed-screen > strong:first-child, .story-action strong { color: var(--diagram-ink); }
  .story-action { display: grid; justify-items: center; gap: .75rem; text-align: center; }
  .decision-flow { display: grid; grid-template-columns: 1fr 2rem 1.2fr 2rem 1fr; gap: .5rem; align-items: center; }
  .model-node { display: grid; gap: .5rem; padding: 1rem; border: 1px solid var(--docs-line); border-radius: .5rem; }
  .model-role { color: var(--sl-color-gray-2); }
  .model-node > strong { font-size: 1.125rem; }
  .command-node { border-style: dashed; }
  .model-node[data-diagram-role] { background: var(--diagram-surface); border-color: var(--diagram-line); }
  [data-diagram-role] .model-role { color: var(--diagram-ink); }
  .decision-node { background: var(--docs-surface); }
  .query-flow { display: grid; grid-template-columns: 1fr 2rem 1fr; gap: 1rem; align-items: center; }
  .model-history { display: grid; gap: 1rem; }
  .opening-stock { color: var(--sl-color-gray-2); }
  .query-answers { display: grid; gap: 1rem; padding-inline-start: 1rem; border-inline-start: 1px solid var(--docs-line); }
  .query-answer { display: grid; grid-template-columns: 1fr auto; gap: .25rem 1rem; }
  .query-answer .model-role { grid-column: 1; }
  .query-answer > strong { grid-column: 1; }
  .query-value { grid-column: 2; grid-row: 1 / 3; align-self: center; font-size: 2rem; font-weight: 650; font-variant-numeric: tabular-nums; color: var(--diagram-ink); }
  @media (max-width: 35rem) {
    .customer-story, .decision-flow, .query-flow { grid-template-columns: 1fr; gap: 1rem; }
    .story-action { gap: .25rem; }
    .model-tour .flow-arrow { transform: rotate(90deg); justify-self: center; }
    .shop-screen { grid-template-columns: 1fr auto; gap: .25rem 1rem; padding: 1rem; }
    .shop-screen .stock-number { grid-column: 2; grid-row: 1 / 3; margin: 0; align-self: center; }
    .shop-screen > :last-child { grid-column: 1; }
    .query-answers { grid-template-columns: 1fr 1fr; padding: 0; border: 0; gap: 1rem; }
    .query-answer { grid-template-columns: 1fr; padding-block-start: .75rem; border-top: 1px solid var(--diagram-line); }
    .query-value { grid-column: 1; grid-row: 3; }
  }
</style>
