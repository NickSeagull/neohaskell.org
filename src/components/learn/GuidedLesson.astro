---
import OrderExample from './OrderExample.astro';
const steps = [
 { id:'command', title:'Commands start with an intention.', stage:1, lead:'A customer wants one ceramic mug. Nothing has happened yet.', body:'That intention is a command: Place order. It carries the information the application needs, including which product and how many. Asking for a change does not mean the change is allowed.', takeaway:'A command says what should happen.' },
 { id:'decision', title:'Decisions determine what can happen.', stage:2, lead:'The customer wants one mug. The shop has three. This order can be accepted.', body:'The decision compares the command with the current state and your application’s conditions. Here, the quantity must be positive and no greater than the stock. You define this behavior; an AI agent is not making the runtime decision.', takeaway:'A decision can accept or reject the intention.' },
 { id:'event', title:'Events record what happened.', stage:3, lead:'The accepted order adds OrderPlaced to the event ledger.', body:'The event records a fact. It stays in history after the application moves on. In this small model, an accepted order consumes the quantity ordered. The ledger shows events from this order; the opening stock is supplied separately. The query updates in the next step.', takeaway:'A recorded event is part of the application’s history.' },
 { id:'query', title:'Queries give the current answer.', stage:4, lead:'After ordering one of the three mugs, the stock query returns two.', body:'A query reads the current state. It answers a question the application needs now, such as how many mugs are available. The answer can change as more events happen; OrderPlaced remains a fact about this order.', takeaway:'The query is the answer. The ledger is the history.' },
 { id:'sold-out', title:'An intention can be turned down.', stage:5, lead:'A new scenario: there are no mugs left. The customer still wants one.', body:'The decision rejects this command. No OrderPlaced event is recorded, and the stock query still returns zero. A rejected intention has not become an accepted order. Payments, shipping, and concurrent orders need their own behavior to be defined.', takeaway:'Rejection leaves this order’s event ledger empty.' }
];
---
<div class="guided-doc scene-doc" data-guided-lesson>
  <header class="lesson-heading"><h1 id="_top">One order. <span>Four ideas.</span></h1><p>An illustrative shop with three mugs.</p></header>
  <div class="lesson-layout">
    <div class="lesson-scenes">
      {steps.map(step => <section class="lesson-step" id={step.id} data-lesson-step={step.stage} data-scroll-scene aria-labelledby={`${step.id}-heading`}>
        <div class="scene-copy"><h2 id={`${step.id}-heading`}><a href={`#${step.id}`}>{step.title}</a></h2><p class="step-lead">{step.lead}</p><p>{step.body}</p><p class="takeaway">{step.takeaway}</p></div>
      </section>)}
    </div>
    <aside class="lesson-companion" aria-label="Interactive order model" data-lesson-companion>
      <OrderExample id="lesson-model" />
    </aside>
  </div>
  <a class="next-lesson" href="/getting-started/"><span>Next<strong>Build with an AI agent</strong></span><svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"/></svg></a>
</div>
<script>
  import '../../scripts/guided-lesson';
</script>
