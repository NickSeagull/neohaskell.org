---
const behaviors = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
const cases = [
  { title: 'Implicit dependencies', rework: [0, 0, 0, 1, 1, 2, 3], explicit: false },
  { title: 'Visible boundaries and contracts', rework: [0, 0, 0, 0, 0, 0, 0], explicit: true },
];
---
<figure class="growth-comparison not-content" aria-label="Conceptual comparison. Hidden dependencies add rework to earlier behaviors as new ones are introduced. Visible boundaries and shared contracts aim to keep the effort per added behavior roughly steady. The curves are illustrative, not measurements.">
  {cases.map(scenario => (
    <div class:list={['growth-case', { 'explicit-contracts': scenario.explicit }]}>
      <strong class="case-title">{scenario.title}</strong>
      <div class="growth-chart">
        <span class="effort-axis">Effort per change</span>
        <div class="growth-plot">
          <svg class="effort-curve" viewBox="0 0 320 224" preserveAspectRatio="none" fill="none" aria-hidden="true">
            {scenario.explicit ? <path d="M8 155 C110 154 210 150 303 144 m-10-6 10 6-9 8" /> : <path d="M8 155 C120 147 230 98 303 30 m-13 2 13-2-3 13" />}
          </svg>
          <div class="behavior-bars">
            {behaviors.map((behavior, index) => <div class="behavior-stack"><span class="behavior-block">{behavior}</span>{Array.from({ length: scenario.rework[index] }, () => <span class="rework-block">R</span>)}</div>)}
          </div>
        </div>
        <div class="contract-label">{scenario.explicit && <span>Shared contracts</span>}</div>
        <span class="behavior-axis">Behaviors added</span>
      </div>
    </div>
  ))}
</figure>
<style>
  .growth-comparison { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 2rem; margin: 2rem 0; color: var(--sl-color-white); font-size: 1rem; line-height: 1.5; --rework-ink: #f2a6b4; --rework-surface: #3b2130; }
  :global([data-theme='light']) .growth-comparison { --rework-ink: #963b50; --rework-surface: #fbeaf0; }
  .growth-comparison :is(div, span, strong, svg) { margin: 0; }
  .case-title { display: block; min-height: 3rem; font-weight: 650; }
  .growth-chart { display: grid; grid-template-columns: 1.75rem 1fr; grid-template-rows: 14rem 2rem auto; }
  .effort-axis { writing-mode: vertical-rl; transform: rotate(180deg); justify-self: start; align-self: center; color: var(--sl-color-gray-2); }
  .growth-plot { position: relative; grid-column: 2; border-inline-start: 1px solid var(--sl-color-gray-3); border-bottom: 1px solid var(--sl-color-gray-3); }
  .effort-curve { position: absolute; width: 100%; height: 100%; color: var(--rework-ink); }
  .effort-curve path { stroke: currentColor; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .behavior-bars { position: absolute; inset: auto .5rem 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); align-items: end; gap: .25rem; }
  .behavior-stack { display: grid; gap: .125rem; }
  .behavior-stack > span { display: grid; place-items: center; height: 2rem; border: 1px solid var(--sl-color-gray-3); background: var(--docs-surface); }
  .behavior-stack .rework-block { color: var(--rework-ink); background: var(--rework-surface); border-color: var(--rework-ink); }
  .explicit-contracts .effort-curve { color: var(--sl-color-text-accent); }
  .explicit-contracts .behavior-bars { border-bottom: 2px solid var(--docs-violet); }
  .contract-label { grid-column: 2; text-align: center; color: var(--sl-color-gray-2); padding-top: .25rem; }
  .behavior-axis { grid-column: 2; text-align: center; color: var(--sl-color-gray-2); }
</style>
