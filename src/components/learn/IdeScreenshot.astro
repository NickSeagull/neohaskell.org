---
import { messages } from '../../i18n/runtime';
const t = messages(Astro.locals.starlightRoute.locale ?? 'en');
const screenshot = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/docs/mug-shop-ide.png`;
---
<a class="ide-screenshot" href={screenshot} aria-label={t("lesson.open-the-full-size-neohaskell-ide-screenshot")}>
  <img src={screenshot} width="2880" height="1700" loading="lazy" alt={t("lesson.neohaskell-ide-showing-the-orders-feature-place-order-and-cancel-order-chapters-four-slice")} />
</a>
<style>
  .ide-screenshot { display: block; margin: 2rem 0; cursor: zoom-in; }
  .ide-screenshot img { display: block; width: 100%; height: auto; border: 1px solid var(--docs-line); border-radius: .5rem; }
  .ide-screenshot:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
</style>
