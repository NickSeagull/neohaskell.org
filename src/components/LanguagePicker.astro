---
import { locales, localePath } from '../i18n/locales.mjs';
import { messages } from '../i18n/runtime';
interface Props { locale?: string; path?: string; }
const { locale = 'en', path = Astro.url.pathname } = Astro.props;
---
<details class="language-picker">
  <summary aria-label={messages(locale)('language.label')}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 5h12M9 2v3m-4 0c0 6 4 9 9 11M13 5c0 6-4 9-9 11m10 5 4-11 4 11m-6-4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <span>{locales.find(({ code }) => code === locale)?.label}</span>
  </summary>
  <nav aria-label={messages(locale)('language.label')}>
    {locales.map(({ code, lang, label }) => <a href={localePath(code, path)} lang={lang} hreflang={lang} aria-current={code === locale ? 'true' : undefined}>{label}</a>)}
  </nav>
</details>
<script>
  for (const picker of document.querySelectorAll<HTMLDetailsElement>('.language-picker')) {
    picker.addEventListener('toggle', () => {
      if (!picker.open) return;
      for (const link of picker.querySelectorAll<HTMLAnchorElement>('a')) {
        const url = new URL(link.href);
        url.hash = window.location.hash;
        link.href = url.href;
      }
    });
    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false;
        picker.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
    });
  }
</script>
<style>
  .language-picker { position: relative; flex-shrink: 0; font-size: 16px; }
  summary { display: flex; align-items: center; gap: 8px; min-height: 44px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  nav { position: absolute; right: 0; top: 100%; z-index: 20; min-width: 176px; max-height: 60vh; overflow-y: auto; padding: 8px; border: 1px solid var(--rule, var(--sl-color-hairline)); border-radius: 8px; background: var(--ground, var(--sl-color-bg)); }
  nav a { display: block; padding: 8px 12px; min-height: 40px; text-decoration: none; color: inherit; }
  nav a:hover, nav a[aria-current] { background: var(--hover, var(--sl-color-gray-6)); }
  :global(.mobile-preferences) .language-picker[open] { flex-basis: 100%; }
  :global(.mobile-preferences) nav { position: static; margin-top: 8px; }
  :global(.mobile-preferences) .language-picker[open] summary { width: auto; justify-content: start; }
  :global(.mobile-preferences) .language-picker[open] summary span { display: inline; }
  @media (max-width: 760px) { summary { justify-content: center; width: 44px; } summary span { display: none; } }
</style>
