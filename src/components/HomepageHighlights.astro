---
import Arrow from './Arrow.astro';
import { messages, sitePath } from '../i18n/runtime';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = messages(locale);
const modelPage = sitePath(locale, '/introduction/event-modeling/');
const screenshot = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/docs/mug-shop-ide.png`;
---

<div class="homepage-highlights" id="highlights" lang="en">
  <section class="ide-highlight" aria-labelledby="ide-title">
    <div class="highlight-copy">
      <h2 id="ide-title">{t('home.visual-ide-title')}</h2>
      <p>{t('home.visual-ide-description')}</p>
      <a class="text-link" href={`${modelPage}#use-the-model-to-understand-the-code`}>{t('home.visual-ide-action')}<Arrow /></a>
    </div>
    <a class="homepage-ide-preview" href={screenshot} aria-label={t('lesson.open-the-full-size-neohaskell-ide-screenshot')}>
      <img src={screenshot} width="2880" height="1700" loading="lazy" alt={t('lesson.neohaskell-ide-showing-the-orders-feature-place-order-and-cancel-order-chapters-four-slice')} />
    </a>
  </section>

  <div class="spec-freeze-pair">
    <section class="spec-highlight" aria-labelledby="spec-title">
      <div class="highlight-copy">
        <h2 id="spec-title">{t('home.app-spec-title')}</h2>
        <p>{t('home.app-spec-description')}</p>
      </div>
      <pre class="homepage-spec" tabindex="0" aria-label={t('home.app-spec-code-label')}><code><span class="spec-keyword">feature</span> <span class="spec-string">"Orders"</span> <span class="spec-keyword">do</span>{'\n'}  <span class="spec-keyword">chapter</span> <span class="spec-string">"Place order"</span> <span class="spec-keyword">do</span>{'\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Accept order"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">entity</span> @Order <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">command</span> @PlaceOrder <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">produces</span> @OrderPlaced</code></pre>
      <a class="text-link" href={`${modelPage}#keep-the-specification-in-the-application`}>{t('home.app-spec-action')}<Arrow /></a>
    </section>

    <section class="freeze-highlight" aria-labelledby="freeze-title">
      <div class="highlight-copy">
        <h2 id="freeze-title">{t('home.freeze-code-title')}</h2>
        <p>{t('home.freeze-code-description')}</p>
      </div>
      <div class="freeze-scene" role="img" aria-label={t('home.freeze-code-graphic-label')}>
        <div class="frozen-contract">
          <div class="frozen-contract-content">
            <span class="contract-state">{t('home.frozen-on-deploy')}</span>
            <code>PlaceOrder</code>
          </div>
          <svg class="contract-ice" viewBox="0 0 480 160" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <path class="ice-body" d="M12 24 36 12 100 18 124 8 182 16 220 10 264 18 308 8 360 16 408 10 464 24 470 54 460 78 472 108 452 128 408 124 384 138 332 128 280 136 224 128 180 136 128 126 80 134 24 124 8 104 16 76 6 48Z" />
            <path class="ice-facet" fill-rule="evenodd" d="M12 24 36 12 100 18 124 8 182 16 220 10 264 18 308 8 360 16 408 10 464 24 470 54 460 78 472 108 452 128 408 124 384 138 332 128 280 136 224 128 180 136 128 126 80 134 24 124 8 104 16 76 6 48ZM36 40 60 38 100 30 142 42 208 30 264 32 300 34 360 30 396 38 440 40 442 92 426 108 368 110 332 108 284 114 224 108 168 112 128 106 88 110 40 104Z" />
            <path class="ice-icicles" d="m56 128 8 28 12-26m42-2 6 16 8-17m208 4 8 24 10-22m56-7 8 22 8-24" />
            <path class="ice-edge" d="m36 12 24 26 40-20m24-10 18 34 40-26m126-8-8 26 60-18m48-6-12 28 68-14m8 84-30-16 10 36m-44-4-24 14-16-28m-88 26 4-22-60 14m-44 8-12-24-40 14m-48 8 8-24-64 14M8 104l28-10-20-18M6 48l28 10-22-34" />
            <path class="ice-crack" d="m142 42 14 10-6 12m246-26-12 14 8 10M88 110l16-12-4-12m268 24-8-12 10-12" />
          </svg>
        </div>
        <div class="new-contract">
          <span class="contract-state">{t('home.new-behavior')}</span>
          <code>PlaceOrderWithContact</code>
        </div>
      </div>
      <a class="text-link" href={`${modelPage}#freeze-the-contract-when-it-is-deployed`}>{t('home.freeze-code-action')}<Arrow /></a>
    </section>
  </div>
</div>

<style>
  .homepage-highlights { padding-bottom: 80px; }
  .ide-highlight { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); align-items: center; gap: 64px; padding: 64px 0; border-top: 1px solid var(--rule); }
  .highlight-copy p { margin-top: 24px; max-width: 48ch; }
  .highlight-copy .text-link { margin-top: 24px; }
  .homepage-ide-preview { display: block; min-width: 0; border-radius: 12px; overflow: hidden; cursor: zoom-in; }
  .homepage-ide-preview img { display: block; width: 100%; height: auto; }
  .spec-freeze-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; padding-top: 64px; border-top: 1px solid var(--rule); }
  .spec-freeze-pair section { display: flex; flex-direction: column; min-width: 0; }
  .spec-freeze-pair h2 { font-size: clamp(36px, 3.2vw, 44px); max-width: 18ch; }
  .spec-freeze-pair .highlight-copy { flex: 1; }
  .spec-freeze-pair .text-link { margin-top: 24px; align-self: flex-start; }
  .homepage-spec { margin: 32px 0 0; padding: 28px 24px; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) var(--scene); border: 1px solid var(--rule); border-radius: 12px; background: var(--scene); color: var(--ink); font-size: 16px; line-height: 1.8; tab-size: 2; }
  .homepage-spec code { font-family: ui-monospace, monospace; }
  .spec-keyword { color: var(--violet); }
  .spec-string { color: var(--accent); }
  .freeze-scene { display: grid; gap: 12px; margin-top: 32px; padding: 0 8px; min-height: 230px; }
  .frozen-contract { position: relative; min-height: 144px; display: grid; place-items: center; }
  .frozen-contract-content { position: relative; z-index: 1; text-align: center; padding: 36px 32px; }
  .contract-state { display: block; color: var(--muted); font-size: 16px; margin-bottom: 4px; }
  .freeze-scene code { font-family: ui-monospace, monospace; font-size: 18px; color: var(--ink); }
  .contract-ice { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ice-body { fill: #153b52; stroke: #a5e5ef; stroke-width: 1; }
  .ice-facet { fill: #94dcf1; fill-opacity: .45; }
  .ice-icicles { fill: #94dcf1; stroke: #a5e5ef; stroke-width: 1; }
  .ice-edge { stroke: #d1f6ff; stroke-opacity: .8; stroke-width: 1; }
  .ice-crack { stroke: #a5e5ef; stroke-opacity: .4; }
  .frozen-contract .contract-state { color: #bbdfeb; }
  .frozen-contract code { color: #f2fcff; }
  .new-contract { margin: 0 32px; border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; text-align: center; }
  :global([data-theme='light']) .ice-body { fill: #edf9fc; stroke: #3e859c; }
  :global([data-theme='light']) .ice-facet { fill: #7bc6dc; fill-opacity: .45; }
  :global([data-theme='light']) .ice-icicles { fill: #7bc6dc; stroke: #3e859c; }
  :global([data-theme='light']) .ice-edge { stroke: #3e859c; stroke-opacity: .6; }
  :global([data-theme='light']) .ice-crack { stroke: #3e859c; stroke-opacity: .5; }
  :global([data-theme='light']) .frozen-contract .contract-state { color: #365b6a; }
  :global([data-theme='light']) .frozen-contract code { color: #153b52; }
  @media (max-width: 1100px) {
    .ide-highlight { gap: 40px; }
    .spec-freeze-pair { gap: 40px; }
    .homepage-spec { padding-inline: 20px; }
  }
  @media (max-width: 760px) {
    .homepage-highlights { padding-bottom: 64px; }
    .ide-highlight { grid-template-columns: 1fr; gap: 32px; padding: 48px 0; }
    .homepage-ide-preview { margin-inline: -8px; }
    .spec-freeze-pair { grid-template-columns: 1fr; gap: 48px; padding-top: 48px; }
    .spec-freeze-pair h2 { max-width: 19ch; }
    .highlight-copy p { margin-top: 20px; }
    .freeze-highlight { padding-top: 48px; border-top: 1px solid var(--rule); }
    .homepage-spec { padding: 24px 16px; margin-top: 24px; }
    .freeze-scene { padding: 0; margin-top: 24px; }
    .new-contract { margin-inline: 12px; }
    .freeze-scene code { font-size: 16px; }
  }
</style>
