---
import Arrow from './Arrow.astro';
import FeatureIcon from './FeatureIcon.astro';
import { messages, sitePath } from '../i18n/runtime';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = messages(locale);
const modelPage = sitePath(locale, '/introduction/event-modeling/');
const screenshot = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/docs/mug-shop-ide.png`;
---

<div class="homepage-highlights" id="highlights" lang="en">
  <section class="ide-highlight" aria-labelledby="ide-title">
    <div class="ide-intro">
      <h2 id="ide-title">{t('home.visual-ide-title')}</h2>
      <div class="highlight-copy">
        <p>{t('home.visual-ide-description')}</p>
        <a class="text-link" href={`${modelPage}#use-the-model-to-understand-the-code`}>{t('home.visual-ide-action')}<Arrow /></a>
      </div>
    </div>
    <div class="homepage-ide-preview" tabindex="0" role="region" aria-label="Order process in the NeoHaskell visual IDE">
      <a class="homepage-ide-image" href={screenshot} aria-label={t('lesson.open-the-full-size-neohaskell-ide-screenshot')}>
        <img src={screenshot} width="2880" height="1700" loading="lazy" alt="The visual IDE connects PlaceOrder and CancelOrder to their recorded events and AvailableMugs queries." />
      </a>
    </div>
  </section>

  <div class="spec-freeze-pair">
    <section class="spec-highlight" aria-labelledby="spec-title">
      <div class="highlight-copy">
        <h2 id="spec-title">{t('home.app-spec-title')}</h2>
        <p>{t('home.app-spec-description')}</p>
      </div>
      <pre class="homepage-spec" tabindex="0" aria-label={t('home.app-spec-code-label')}><code><span class="spec-keyword">feature</span> <span class="spec-string">"Orders"</span> <span class="spec-keyword">do</span>{'\n'}  <span class="spec-keyword">chapter</span> <span class="spec-string">"Place order"</span> <span class="spec-keyword">do</span>{'\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Accept order"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">entity</span> @Order <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">command</span> @PlaceOrder <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">produces</span> @OrderPlaced{'\n\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Show stock"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">query</span> @AvailableMugs <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">readsFrom</span> @Order <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">onEvent</span> @OrderPlaced</code></pre>
      <a class="text-link" href={`${modelPage}#keep-the-specification-in-the-application`}>{t('home.app-spec-action')}<Arrow /></a>
    </section>

    <section class="freeze-highlight" aria-labelledby="freeze-title">
      <div class="highlight-copy">
        <h2 id="freeze-title">{t('home.freeze-code-title')}</h2>
        <p>{t('home.freeze-code-description')}</p>
        <a class="text-link" href={`${modelPage}#freeze-the-contract-when-it-is-deployed`}>{t('home.freeze-code-action')}<Arrow /></a>
      </div>
      <figure class="freeze-scene" aria-label="The existing checkout keeps using the frozen Place order contract. An updated checkout uses a separate Place order with contact contract, adding email without changing the original.">
        <div class="contract-lane">
          <div class="checkout"><FeatureIcon name="web" /><span>Existing<br />checkout</span></div>
          <svg class="contract-route" viewBox="0 0 64 24" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 12h60m-7-7 7 7-7 7" /></svg>
          <div class="contract" data-diagram-role="command">
            <div class="contract-name"><strong>Place order</strong><svg class="contract-lock" width="20" height="24" viewBox="0 0 20 24" fill="none" aria-label="Frozen contract" role="img"><path d="M5 10V6a5 5 0 0 1 10 0v4M2 10h16v12H2zM10 15v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
            <div class="contract-fields"><span>product</span><span>quantity</span></div>
          </div>
        </div>
        <div class="contract-lane">
          <div class="checkout"><FeatureIcon name="web" /><span>Updated<br />checkout</span></div>
          <svg class="contract-route" viewBox="0 0 64 24" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 12h60m-7-7 7 7-7 7" /></svg>
          <div class="contract" data-diagram-role="command">
            <div class="contract-name"><strong>Place order<br />with contact</strong></div>
            <div class="contract-fields"><span>product</span><span>quantity</span><span class="added-field">+ email</span></div>
          </div>
        </div>
      </figure>
    </section>
  </div>
</div>

<style>
  .homepage-highlights { padding-bottom: 96px; }
  .ide-highlight { padding: 64px 0 80px; border-top: 1px solid var(--rule); }
  .ide-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 64px; margin-bottom: 40px; }
  .ide-intro h2 { max-width: 16ch; }
  .highlight-copy p { margin-top: 24px; max-width: 48ch; }
  .ide-intro p { margin-top: 0; }
  .highlight-copy .text-link { margin-top: 24px; }
  .homepage-ide-preview { display: block; position: relative; min-width: 0; aspect-ratio: 2.12; border-radius: 12px; overflow: hidden; cursor: zoom-in; }
  .homepage-ide-image { display: block; }
  .homepage-ide-preview img { display: block; width: 100%; height: auto; }
  .spec-freeze-pair { border-top: 1px solid var(--rule); }
  .spec-highlight { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 24px 64px; align-items: center; padding: 80px 0; }
  .spec-highlight .highlight-copy { align-self: end; }
  .spec-highlight > .text-link { align-self: start; }
  .spec-highlight .homepage-spec { grid-column: 2; grid-row: 1 / 3; margin: 0; }
  .homepage-spec { padding: 32px; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) var(--scene); border-radius: 12px; background: var(--scene); color: var(--ink); font-size: 16px; line-height: 1.8; tab-size: 2; }
  .homepage-spec code, .contract-fields { font-family: ui-monospace, monospace; }
  .spec-keyword { color: var(--violet); }
  .spec-string { color: var(--accent); }
  .freeze-highlight { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); align-items: center; gap: 64px; padding-top: 80px; border-top: 1px solid var(--rule); }
  .freeze-highlight h2 { max-width: 16ch; }
  .freeze-scene { display: grid; gap: 32px; padding: 24px 0 24px 24px; }
  .contract-lane { display: grid; grid-template-columns: 104px 64px minmax(0, 1fr); align-items: center; }
  .checkout { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; color: var(--muted); font-size: 16px; line-height: 1.5; }
  .checkout :global(svg) { width: 32px; height: 32px; color: var(--ink); }
  .contract-route { width: 100%; height: 24px; color: var(--muted); }
  .contract-route path { stroke: currentColor; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .contract { min-width: 0; padding: 20px 24px; border: 1px solid var(--diagram-line); border-radius: 8px; color: var(--diagram-ink); background: var(--diagram-surface); }
  .contract-name { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .contract-name strong { font-weight: 500; font-size: 20px; line-height: 1.35; }
  .contract-lock { flex-shrink: 0; }
  .contract-fields { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 16px; font-size: 16px; line-height: 1.5; }
  .added-field { flex-basis: 100%; font-weight: 600; }
  @media (max-width: 1100px) {
    .ide-intro, .spec-highlight, .freeze-highlight { gap: 32px; }
    .freeze-scene { padding-left: 0; }
    .contract-lane { grid-template-columns: 88px 40px minmax(0, 1fr); }
    .contract { padding: 20px 16px; }
    .contract-name strong { font-size: 18px; }
    .homepage-spec { padding-inline: 24px; }
  }
  @media (max-width: 760px) {
    .homepage-highlights { padding-bottom: 64px; }
    .ide-highlight { padding: 48px 0; }
    .ide-intro { grid-template-columns: 1fr; gap: 24px; margin-bottom: 32px; }
    .ide-intro h2 { max-width: 18ch; }
    .spec-highlight, .freeze-highlight { grid-template-columns: 1fr; gap: 32px; }
    .spec-highlight { padding: 48px 0; }
    .spec-highlight .homepage-spec { grid-column: auto; grid-row: auto; }
    .spec-highlight > .text-link { grid-row: 3; }
    .highlight-copy p { margin-top: 20px; }
    .ide-intro p { margin-top: 0; }
    .homepage-spec { padding: 24px 16px; }
    .freeze-highlight { padding-top: 48px; }
    .freeze-scene { width: 100%; max-width: 520px; margin-inline: auto; padding: 0; gap: 24px; }
    .contract-lane { grid-template-columns: 88px 40px minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .homepage-ide-preview { height: 464px; aspect-ratio: auto; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) var(--scene); }
    .homepage-ide-image { position: relative; width: 1160px; height: 448px; overflow: hidden; }
    .homepage-ide-preview img { position: absolute; width: 1800px; max-width: none; left: -520px; top: -312px; }
    .contract-lane { grid-template-columns: 80px 24px minmax(0, 1fr); }
    .contract { padding: 16px 12px; }
    .contract-name { gap: 8px; }
    .contract-name strong { font-size: 18px; }
    .contract-fields { display: grid; gap: 4px; margin-top: 12px; }
  }
</style>
