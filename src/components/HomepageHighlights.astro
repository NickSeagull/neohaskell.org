---
import Arrow from './Arrow.astro';
import { messages, sitePath } from '../i18n/runtime';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = messages(locale);
const modelPage = sitePath(locale, '/introduction/event-modeling/');
const asset = (name: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/home/${name}`;
const screenshot = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/docs/mug-shop-ide.png`;
---

<div class="homepage-highlights" id="highlights" lang="en">
  <section class="ide-highlight" aria-labelledby="ide-title">
    <div class="highlight-copy">
      <h2 id="ide-title">{t('home.visual-ide-title')}</h2>
      <p>{t('home.visual-ide-description')}</p>
      <a class="text-link" href={`${modelPage}#use-the-model-to-understand-the-code`}>{t('home.visual-ide-action')}<Arrow /></a>
    </div>
    <a class="homepage-ide-preview" href={screenshot} aria-label={t('lesson.open-the-full-size-neohaskell-ide-screenshot')}>
      <img src={screenshot} width="2880" height="1700" loading="lazy" alt={t('lesson.neohaskell-ide-showing-the-orders-feature-place-order-and-cancel-order-chapters-four-slice')} />
    </a>
  </section>

  <div class="spec-freeze-pair">
    <section class="spec-highlight" aria-labelledby="spec-title">
      <div class="highlight-copy">
        <h2 id="spec-title">{t('home.app-spec-title')}</h2>
        <p>{t('home.app-spec-description')}</p>
      </div>
      <pre class="homepage-spec" tabindex="0" aria-label={t('home.app-spec-code-label')}><code><span class="spec-keyword">feature</span> <span class="spec-string">"Orders"</span> <span class="spec-keyword">do</span>{'\n'}  <span class="spec-keyword">chapter</span> <span class="spec-string">"Place order"</span> <span class="spec-keyword">do</span>{'\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Accept order"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">entity</span> @Order <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">command</span> @PlaceOrder <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">produces</span> @OrderPlaced{'\n\n'}    <span class="spec-keyword">slice</span> <span class="spec-string">"Show stock"</span> <span class="spec-keyword">do</span>{'\n'}      <span class="spec-keyword">query</span> @AvailableMugs <span class="spec-keyword">do</span>{'\n'}        <span class="spec-keyword">readsFrom</span> @Order <span class="spec-keyword">do</span>{'\n'}          <span class="spec-keyword">onEvent</span> @OrderPlaced</code></pre>
      <a class="text-link" href={`${modelPage}#keep-the-specification-in-the-application`}>{t('home.app-spec-action')}<Arrow /></a>
    </section>

    <section class="freeze-highlight" aria-labelledby="freeze-title">
      <div class="highlight-copy">
        <h2 id="freeze-title">{t('home.freeze-code-title')}</h2>
        <p>{t('home.freeze-code-description')}</p>
      </div>
      <div class="freeze-scene">
        <div class="contract-artwork frozen-contract">
          <img src={asset('frozen-code-frame.webp')} width="1024" height="1024" loading="lazy" alt="" />
          <pre class="contract-code" tabindex="0" aria-label="Frozen PlaceOrder datatype"><code><span class="datatype-keyword">data</span> PlaceOrder ={'\n'}  PlaceOrder {'{'}{'\n'}    product :: Text,{'\n'}    quantity :: Int{'\n'}  {'}'}</code></pre>
        </div>
        <div class="contract-artwork new-contract">
          <img src={asset('new-code-star.webp')} width="1024" height="1024" loading="lazy" alt="" />
          <pre class="contract-code" tabindex="0" aria-label="New PlaceOrderWithContact datatype"><code><span class="datatype-keyword">data</span> PlaceOrderWithContact ={'\n'}  PlaceOrderWithContact {'{'}{'\n'}    product :: Text,{'\n'}    quantity :: Int,{'\n'}    email :: Text{'\n'}  {'}'}</code></pre>
        </div>
      </div>
      <a class="text-link" href={`${modelPage}#freeze-the-contract-when-it-is-deployed`}>{t('home.freeze-code-action')}<Arrow /></a>
    </section>
  </div>
</div>

<style>
  .homepage-highlights { padding-bottom: 80px; }
  .ide-highlight { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); align-items: center; gap: 64px; padding: 64px 0; border-top: 1px solid var(--rule); }
  .highlight-copy p { margin-top: 24px; max-width: 48ch; }
  .highlight-copy .text-link { margin-top: 24px; }
  .homepage-ide-preview { display: block; min-width: 0; border-radius: 12px; overflow: hidden; cursor: zoom-in; }
  .homepage-ide-preview img { display: block; width: 100%; height: auto; }
  .spec-freeze-pair { padding-top: 64px; border-top: 1px solid var(--rule); }
  .spec-highlight { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: 24px 64px; align-items: center; }
  .spec-highlight .highlight-copy { align-self: end; }
  .spec-highlight > .text-link { align-self: start; }
  .spec-highlight .homepage-spec { grid-column: 2; grid-row: 1 / 3; margin: 0; }
  .freeze-highlight { margin-top: 64px; padding-top: 64px; border-top: 1px solid var(--rule); }
  .freeze-highlight .highlight-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .freeze-highlight .highlight-copy p { margin-top: 0; }
  .freeze-highlight > .text-link { margin-top: 24px; }
  .homepage-spec { margin: 32px 0 0; padding: 28px 24px; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) var(--scene); border: 1px solid var(--rule); border-radius: 12px; background: var(--scene); color: var(--ink); font-size: 16px; line-height: 1.8; tab-size: 2; }
  .homepage-spec code { font-family: ui-monospace, monospace; }
  .spec-keyword { color: var(--violet); }
  .spec-string { color: var(--accent); }
  .freeze-scene { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; margin-top: 32px; }
  .contract-artwork { position: relative; display: grid; place-items: center; aspect-ratio: 1; min-width: 0; }
  .frozen-contract::after { content: ''; position: absolute; z-index: 1; inset: 16% 7% 24%; border-radius: 12%; background: #bdeff7; }
  .contract-artwork img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .contract-code { position: relative; z-index: 2; width: max-content; max-width: 80%; margin: 0; padding: 8px 4px; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #73578a transparent; color: #20132b; font-size: 18px; line-height: 1.65; tab-size: 2; }
  .contract-code code { font-family: ui-monospace, monospace; }
  .new-contract .contract-code { top: 5%; }
  .datatype-keyword { color: #63307f; }
  @media (max-width: 1100px) {
    .ide-highlight { gap: 40px; }
    .spec-highlight, .freeze-highlight .highlight-copy { gap: 24px 40px; }
    .homepage-spec { padding-inline: 20px; }
    .contract-code { font-size: 16px; }
  }
  @media (max-width: 760px) {
    .homepage-highlights { padding-bottom: 64px; }
    .ide-highlight { grid-template-columns: 1fr; gap: 32px; padding: 48px 0; }
    .homepage-ide-preview { margin-inline: -8px; }
    .spec-freeze-pair { padding-top: 48px; }
    .spec-highlight { grid-template-columns: 1fr; gap: 24px; }
    .spec-highlight .homepage-spec { grid-column: auto; grid-row: auto; }
    .spec-highlight > .text-link { grid-row: 3; }
    .highlight-copy p { margin-top: 20px; }
    .freeze-highlight { margin-top: 48px; padding-top: 48px; }
    .freeze-highlight .highlight-copy { grid-template-columns: 1fr; gap: 20px; }
    .homepage-spec { padding: 24px 16px; margin-top: 24px; }
    .freeze-scene { grid-template-columns: 1fr; gap: 24px; margin-top: 24px; }
    .contract-artwork { max-width: 520px; width: 100%; margin-inline: auto; }
    .contract-code { font-size: 16px; }
  }
</style>
