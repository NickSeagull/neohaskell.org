---
import Arrow from './Arrow.astro';
import FeatureIcon from './FeatureIcon.astro';
import { messages, sitePath } from '../i18n/runtime';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = messages(locale);
const modelPage = sitePath(locale, '/introduction/event-modeling/');
const screenshot = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/docs/mug-shop-ide.png`;
---

<div class="homepage-highlights" id="highlights">
  <section class="ide-highlight" aria-labelledby="ide-title">
    <div class="ide-stage">
      <div class="ide-intro">
        <h2 id="ide-title">{t('home.visual-ide-title')}</h2>
        <div class="highlight-copy">
          <p>{t('home.visual-ide-description')}</p>
          <a class="text-link" href={modelPage}>{t('home.visual-ide-action')}<Arrow /></a>
        </div>
      </div>
      <div class="homepage-ide-preview" tabindex="0" role="region" aria-label={t('home.ide-preview-label')}>
        <a class="homepage-ide-image" href={screenshot} aria-label={t('lesson.open-the-full-size-neohaskell-ide-screenshot')}>
          <img src={screenshot} width="2880" height="1700" loading="lazy" alt={t('home.ide-preview-alt')} />
        </a>
      </div>
    </div>
  </section>

  <section class="freeze-highlight" aria-labelledby="freeze-title">
    <div class="highlight-copy">
      <h2 id="freeze-title">{t('home.freeze-code-title')}</h2>
      <p>{t('home.freeze-code-description')}</p>
      <a class="text-link" href={`${modelPage}#freeze-the-contract-when-it-is-deployed`}>{t('home.freeze-code-action')}<Arrow /></a>
    </div>
    <figure class="freeze-scene" aria-label={t('home.freeze-example-label')}>
      <div class="contract-lane">
        <div class="checkout"><FeatureIcon name="web" /><span>{t('home.existing-checkout')}</span></div>
        <svg class="contract-route" viewBox="0 0 64 24" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 12h60m-7-7 7 7-7 7" /></svg>
        <div class="contract" data-diagram-role="command">
          <div class="contract-name"><strong>{t('home.place-order-contract')}</strong><svg class="contract-lock" width="20" height="24" viewBox="0 0 20 24" fill="none" aria-label={t('home.frozen-contract-label')} role="img"><path d="M5 10V6a5 5 0 0 1 10 0v4M2 10h16v12H2zM10 15v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
          <div class="contract-fields" lang="en"><span>product</span><span>quantity</span></div>
        </div>
      </div>
      <div class="contract-lane">
        <div class="checkout"><FeatureIcon name="web" /><span>{t('home.updated-checkout')}</span></div>
        <svg class="contract-route" viewBox="0 0 64 24" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 12h60m-7-7 7 7-7 7" /></svg>
        <div class="contract" data-diagram-role="command">
          <div class="contract-name"><strong>{t('home.place-order-contact-contract')}</strong></div>
          <div class="contract-fields" lang="en"><span>product</span><span>quantity</span><span class="added-field">+ email</span></div>
        </div>
      </div>
    </figure>
  </section>
</div>

<style>
  .homepage-highlights { padding-bottom: 96px; }
  .ide-highlight { padding: 64px 0 80px; border-top: 1px solid var(--rule); }
  .ide-stage { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; }
  .ide-intro { position: relative; z-index: 1; grid-column: 1 / 5; grid-row: 1; padding: 32px; border-radius: 16px; background: var(--field); }
  .ide-intro h2 { max-width: 12ch; }
  .highlight-copy p { margin-top: 24px; max-width: 48ch; }
  .ide-intro p { margin-top: 24px; }
  .highlight-copy .text-link { margin-top: 24px; }
  .homepage-ide-preview { display: block; position: relative; grid-column: 4 / -1; grid-row: 1; min-width: 0; aspect-ratio: 44 / 21; border-radius: 12px; overflow: hidden; cursor: zoom-in; }
  .homepage-ide-image { display: block; position: absolute; inset: 0; overflow: hidden; }
  /* Frame the actual model at source coordinates 650,310 through 2850,1360. */
  .homepage-ide-preview img { display: block; position: absolute; width: 130.909%; max-width: none; height: auto; left: -29.545%; top: -29.524%; }
  .contract-fields { font-family: ui-monospace, monospace; }
  .freeze-highlight { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 80px; padding-top: 80px; border-top: 1px solid var(--rule); }
  .freeze-highlight h2 { max-width: 12ch; }
  .freeze-scene { display: grid; gap: 24px; width: 100%; max-width: 600px; justify-self: end; padding-block: 16px; }
  .contract-lane { display: grid; grid-template-columns: 104px 48px minmax(0, 1fr); align-items: center; }
  .freeze-scene:not(:lang(en)) .contract-lane { grid-template-columns: 128px 40px minmax(0, 1fr); }
  .checkout { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; color: var(--muted); font-size: 16px; line-height: 1.5; }
  .checkout :global(svg) { width: 32px; height: 32px; color: var(--ink); }
  .contract-route { width: 100%; height: 24px; color: var(--muted); }
  .contract-route path { stroke: currentColor; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .contract { min-width: 0; padding: 20px 24px; border: 1px solid var(--diagram-line); border-radius: 8px; color: var(--diagram-ink); background: var(--diagram-surface); }
  .contract-name { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; min-height: 54px; }
  .contract-name strong { font-weight: 500; font-size: 20px; line-height: 1.35; }
  .contract-lock { flex-shrink: 0; }
  .contract-fields { display: grid; grid-template-columns: max-content max-content; grid-template-rows: repeat(2, 24px); gap: 4px 24px; margin-top: 16px; font-size: 16px; line-height: 1.5; }
  .added-field { grid-column: 1 / -1; font-weight: 600; }
  @media (max-width: 1100px) {
    .freeze-highlight { gap: 32px; }
    .ide-stage { display: block; }
    .ide-intro { padding: 32px; border-radius: 16px 16px 0 0; }
    .ide-intro h2 { max-width: none; }
    .ide-intro p { max-width: 62ch; }
    .homepage-ide-preview { border-radius: 0 0 12px 12px; }
    .contract-lane { grid-template-columns: 88px 40px minmax(0, 1fr); }
    .contract { padding: 20px 16px; }
    .contract-name strong { font-size: 18px; }
  }
  @media (max-width: 760px) {
    .homepage-highlights { padding-bottom: 64px; }
    .ide-highlight { padding: 48px 0; }
    .ide-intro { padding: 32px 24px; }
    .ide-intro h2 { max-width: 12ch; }
    .freeze-highlight { grid-template-columns: 1fr; gap: 32px; }
    .highlight-copy p { margin-top: 20px; }
    .ide-intro p { margin-top: 24px; }
    .freeze-highlight { padding-top: 48px; }
    .freeze-scene { width: 100%; max-width: 520px; margin-inline: auto; padding: 0; gap: 24px; }
    .contract-lane { grid-template-columns: 88px 40px minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .homepage-ide-preview { height: 464px; aspect-ratio: auto; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line) var(--scene); }
    .homepage-ide-image { position: relative; width: 1160px; height: 448px; overflow: hidden; }
    .homepage-ide-preview img { position: absolute; width: 1800px; max-width: none; left: -520px; top: -312px; }
    .contract-lane { grid-template-columns: 80px 24px minmax(0, 1fr); }
    .contract { padding: 16px 12px; }
    .contract-name { gap: 8px; }
    .contract-name strong { font-size: 18px; }
    .contract-fields { grid-template-columns: 1fr; grid-template-rows: repeat(3, 24px); gap: 4px; margin-top: 12px; }
    .freeze-scene:not(:lang(en)) .contract-lane { display: flex; flex-direction: column; align-items: stretch; gap: 12px; }
    .freeze-scene:not(:lang(en)) .checkout { flex-direction: row; align-items: center; }
    .freeze-scene:not(:lang(en)) .contract-route { width: 32px; height: 32px; transform: rotate(90deg); }
  }
</style>
