---
import FeatureIcon from './FeatureIcon.astro';
import { messages } from '../i18n/runtime';
interface Props { locale?: string; kind: 'application' | 'history' | 'pure' | 'transport'; }
const { kind, locale = 'en' } = Astro.props;
const t = messages(locale);
---
{kind === 'application' && (
  <figure class="application-scene" aria-label={t("visual.web-applications-and-ai-agents-share-the-same-neohaskel")}>
    <div class="app-entrances"><span><FeatureIcon name="web" />{t("visual.web-mobile")}</span><span><FeatureIcon name="agent" />{t("visual.ai-agents")}</span></div>
    <div class="app-inlets" aria-hidden="true"><i></i><i></i></div>
    <div class="application-core">
      <div class="app-brand"><img src={`${import.meta.env.BASE_URL}logo.svg`} alt="" width="44" height="44" /><span>NeoHaskell</span></div>
      <div class="app-rule"><span>{t("visual.your-business-rules")}</span><FeatureIcon name="shield" /></div>
      <div class="app-records"><span>{t("visual.every-change-recorded")}</span><div class="record-slips"><div>{t("visual.order-placed")}</div><div>{t("visual.payment-received")}</div><div>{t("visual.order-shipped")}<FeatureIcon name="check" /></div></div></div>
    </div>
    <div class="app-outlets" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="app-services"><span><FeatureIcon name="database" />{t("visual.database")}</span><span><FeatureIcon name="upload" />{t("visual.files")}</span><span><FeatureIcon name="branch" />APIs</span></div>
  </figure>
)}
{kind === 'history' && (
  <figure class="history-scene" aria-label={t("visual.example-shop-history-twelve-mugs-added-one-ordered-then")}>
    <div class="history-ledger">
      <div class="history-entry"><span class="history-point" aria-hidden="true"></span><span>{t("visual.stock-added")}</span><span class="history-amount">+12</span></div>
      <div class="history-entry"><span class="history-point" aria-hidden="true"></span><span>{t("visual.order-placed")}</span><span class="history-amount">-1</span></div>
      <div class="history-entry history-correction"><span class="history-point" aria-hidden="true"></span><span>{t("visual.order-cancelled")}</span><span class="history-amount">+1</span></div>
    </div>
    <div class="history-result"><svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true"><path d="M9 11h23v22a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5V11Zm23 4h4a6 6 0 0 1 0 12h-4M15 4v2m6-2v2m6-2v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg><div><strong>12</strong><span>{t("visual.mugs-available")}</span></div></div>
  </figure>
)}
{kind === 'pure' && (
  <figure class="pure-scene" aria-label={t("visual.pure-business-decisions-are-isolated-from-database-netw")}>
    <div class="pure-boundary">
      <div class="pure-input"><span>{t("visual.same-input")}</span><svg width="32" height="20" viewBox="0 0 32 20" fill="none" aria-hidden="true"><path d="M0 10h28m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg></div>
      <div class="pure-decision"><svg class="decision-outline" viewBox="0 0 140 140" fill="none" aria-hidden="true"><path d="m70 2 68 68-68 68L2 70 70 2Z" /></svg><FeatureIcon name="shield" /><span>{t("visual.pure-decisions")}</span></div>
      <div class="pure-output"><svg width="32" height="20" viewBox="0 0 32 20" fill="none" aria-hidden="true"><path d="M0 10h28m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg><span>{t("visual.same-result")}</span></div>
    </div>
    <div class="effect-ports"><span><FeatureIcon name="database" />{t("visual.database")}</span><span><FeatureIcon name="web" />{t("visual.network")}</span><span><FeatureIcon name="upload" />{t("visual.files")}</span></div>
  </figure>
)}
{kind === 'transport' && (
  <figure class="transport-scene" aria-label={t("visual.http-for-web-and-mobile-clients-and-mcp-for-ai-tools-co")}>
    <div class="transport-core"><img src={`${import.meta.env.BASE_URL}logo.svg`} width="32" height="32" alt="" /><span>{t("visual.your-application")}</span></div>
    <svg class="transport-routes" viewBox="0 0 440 72" fill="none" preserveAspectRatio="none" aria-hidden="true"><path class="route-alternative" d="M220 20h112q12 0 12 12v40" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 5"/><path d="M220 0v20H108q-12 0-12 12v40" stroke="currentColor" stroke-width="1.5" /><circle cx="220" cy="20" r="4" fill="currentColor" /></svg>
    <div class="transport-ports"><div class="port-active"><FeatureIcon name="web" /><strong>HTTP</strong><span>{t("visual.web-mobile")}</span></div><div class="port-alternative"><FeatureIcon name="branch" /><strong>MCP</strong><span>{t("visual.ai-tools")}</span></div></div>
  </figure>
)}
