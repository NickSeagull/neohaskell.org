---
import { Code } from 'astro:components';

interface Props {
  code: string;
  name: string;
  label: string;
}

const { code, name, label } = Astro.props;
---

<Code code={code.trimEnd()} lang="haskell" theme="css-variables" class="counter-code" data-example={name} tabindex="0" role="region" aria-label={label} />
